{
	"name": "obsidian-chess-tools",
	"version": "1.0.0",
	"description": "Chess Functionality for Obsidian, including embedding PGN/FEN files",
	"main": "main.js",
	"scripts": {
		"dev": "pnpm run watch:dev",
		"build:prod": "tsc -noEmit -skipLibCheck && sass ./src:./dist --no-source-map && tsx scripts/esbuild.config.mts production",
		"watch:dev": "tsx scripts/esbuild.config.mts dev",
		"watch:scss": "",
		"version": "tsx version-bump.ts && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@thundercraft5/tsconfig": "^2.0.0",
		"@types/node": "^22.9.0",
		"@typescript-eslint/eslint-plugin": "8.14.0",
		"@typescript-eslint/parser": "8.14.0",
		"builtin-modules": "4.0.0",
		"concurrently": "^9.1.0",
		"esbuild": "0.24.0",
		"obsidian": "latest",
		"sass": "^1.81.0",
		"tslib": "2.8.1",
		"typescript": "5.8.0-dev.20241113"
	},
	"dependencies": {
		"dexie": "^4.0.10",
		"lichess-pgn-viewer": "^2.1.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	}
}
